        function callOpenSubtabByPrimaryTabName(PName, Id, Name) {
            sforce.console.openSubtabByPrimaryTabName(PName, '/' + Id, true, 'case', null, openSuccess);
        }

        var setResult = function setResult(result) {
        //  alert('Primary Tab IDs: ' + result.id);
            ResultId = result.id;
            sforce.console.openSubtab(result.id, '/' + SubId, true, SubName, openSuccess);
        }

        function openSuccess(result) {
            //Report whether we succeeded in opening the subtab
            if (result.success == true) {
                alert('subtab successfully opened, id:');
            } else {
                alert('subtab cannot be opened');
            }
        }

        function testGetFocusedPrimaryTabId() {
            sforce.console.getFocusedPrimaryTabId(showTabId2);
