    <apex:pageMessages />
    <apex:form >
        <table id="ServiceSearch" style="padding:10px;" >
            <tr>
                <td>
                    <apex:inputText id="keyword" value="{!keyword}" />
                </td>
                <td style="text-align:right" colspan="2">
                    <apex:commandButton value="Search" id="SearchButton" action="{!search}" />
                </td>
            </tr>
        </table>

    </apex:form>

    
    <apex:pageBlock id="caseResultsBlock" title="Cases {!casesCount}" tabStyle="Case" mode="String" >
        <apex:pageBlockTable value="{!cases}" var="caseResult" id="caseResultsTable" styleClass="pageBlockStyle" border="1">
            <apex:column headerValue="Number" headerClass="pageBlockStyle">
                <apex:outputLink value="javascript;" onclick="OpenTab('{!caseResult.Id}', '{!caseResult.CaseNumber}');return false">
                    {!caseResult.CaseNumber}
                </apex:outputLink>
            </apex:column>
            <apex:column headerValue="Title" headerClass="pageBlockStyle">
                <apex:outputField value="{!caseResult.Request_Title__c}" />
            </apex:column>
            <apex:column headerValue="Account" headerClass="pageBlockStyle">
                <apex:outputField value="{!caseResult.Account.Name}" />
            </apex:column>
        </apex:pageBlockTable>
    </apex:pageBlock>
    
    <apex:pageBlock id="accountResultsBlock" title="Accounts {!acctCount}" tabStyle="Account">
        <apex:pageBlockTable value="{!acct}" var="accountResult" id="AccountResultsTable" styleClass="pageBlockStyle" border="1">
            <!--<apex:column headerValue="ID" headerClass="pageBlockStyle">
                <apex:outputField value="{!accountResult.Id}" />
            </apex:column>-->
            <apex:column headerValue="Name" headerClass="pageBlockStyle">
                <apex:outputLink value="javascript;" onclick="OpenTab('{!accountResult.Id}', '{!accountResult.Name}');return false">
                    {!accountResult.Name}
                </apex:outputLink>
            </apex:column>
        </apex:pageBlockTable>
    </apex:pageBlock>
    
    <apex:pageBlock id="hwassetsResultsBlock" title="H/W Assets {!hwassetCount}" tabStyle="Asset__c">
        <apex:pageBlockTable value="{!hwasset}" var="hwassetResult" id="hwassetsResultsTable" styleClass="pageBlockStyle" border="1">
            <apex:column headerValue="Name" headerClass="pageBlockStyle">
                <apex:outputLink value="javascript;" onclick="OpenTab('{!hwassetResult.Id}', '{!hwassetResult.Name}');return false">
                    {!hwassetResult.Name}
                </apex:outputLink>
            </apex:column>
            <apex:column headerValue="S/N" headerClass="pageBlockStyle">
                <apex:outputField value="{!hwassetResult.Serial_Number__c}" />
            </apex:column>
            <apex:column headerValue="Account" headerClass="pageBlockStyle">
                <apex:outputField value="{!hwassetResult.Account__r.Name}" />
            </apex:column>
        </apex:pageBlockTable>
    </apex:pageBlock>
    
    <apex:pageBlock id="sassetResultsBlock" title="Service Assets {!sassetCount}" tabStyle="Service_Asset__c">
        <apex:pageBlockTable value="{!sasset}" var="sassetResult" id="sassetResultsTable" styleClass="pageBlockStyle" border="1">
            <apex:column headerValue="Name" headerClass="pageBlockStyle">
                <apex:outputLink value="javascript;" onclick="OpenTab('{!sassetResult.Id}', '{!sassetResult.Name}');return false">
                    {!sassetResult.Name}
                </apex:outputLink>
            </apex:column>
            <apex:column headerValue="Account" headerClass="pageBlockStyle">
                <apex:outputField value="{!sassetResult.Account__r.Name}" />
            </apex:column>
        </apex:pageBlockTable>
    </apex:pageBlock>
    
    <apex:pageBlock id="contactResultsBlock" title="Contacts {!contactCount}" tabStyle="Contact">
        <apex:pageBlockTable value="{!contact}" var="contactResult" id="contactResultsTable" styleClass="pageBlockStyle" border="1">
            <apex:column headerValue="Name" headerClass="pageBlockStyle">
                <apex:outputLink value="javascript;" onclick="OpenTab('{!contactResult.Id}', '{!contactResult.Name}');return false">
                    {!contactResult.Name}
                </apex:outputLink>
            </apex:column>
            <apex:column headerValue="Account" headerClass="pageBlockStyle">
                <apex:outputField value="{!contactResult.Account.Name}" />
            </apex:column>
        </apex:pageBlockTable>
    </apex:pageBlock>
    
</apex:page>