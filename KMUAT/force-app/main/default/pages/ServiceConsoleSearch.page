            //Display the tab ID
            alert('Tab ID: ' + result.id);
            sforce.console.openSubtab(result.id, 'www.salesforce.com', true, 'sf');
        };

        //function openSubtab(Id, PId, Name, PName) {
        function OpenTab(Id, Name) {
            PrimeId = Id;
            PrimeName = Name;

            callOpenPrimaryTab();
        }

        function OpenSubtabByPrimaryTabName(Id, PId, Name, PName) {
            SubId = Id;
            PrimeId = PId;
            SubName = Name;
            PrimeName = PName;

            callOpenPrimaryTab();
        }

