        function callOpenPrimaryTab() {
            sforce.console.openPrimaryTab(undefined, 
               '/' + PrimeId, true, PrimeName);
        }

        function callOpenSubtab() {
            sforce.console.openSubtab(ResultId, '/' + SubId, true, SubName);
