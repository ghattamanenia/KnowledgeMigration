<apex:page showHeader="true" sidebar="true" standardController="JP_QuotationHeader__c" extensions="JP_CopyQuotationToOpportunityController" tabStyle="JP_QuotationHeader__c">
    
    <apex:outputPanel id="out">
        <apex:pageMessages id="msg" escape="false"/>
    </apex:outputPanel>
    
    <apex:form id="form">
        <apex:pageBlock id="syoninsya_Jouhou" mode="edit">
            <!--ボタン-->
            <apex:pageBlockButtons location="bottom">
            <apex:commandButton id="btnCopy" immediate="false" value="商談にコピー" action="{!doCopy}" />
            <apex:commandButton id="btnCancel" immediate="false" value="キャンセル" onclick="window.close()" />
            </apex:pageBlockButtons>
            <apex:pageBlockSection columns="1">
                <apex:inputField value="{!QHeader.JP_OpportunityNo__c}" />
            </apex:pageBlockSection>
        </apex:pageBlock>
    </apex:form>
    
</apex:page>