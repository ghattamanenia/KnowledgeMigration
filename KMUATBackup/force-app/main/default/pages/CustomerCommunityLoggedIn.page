                                <!-- <hr /> -->
                                <!--<h5>My Account</h5>-->
                                <!-- <p><a href="/Support/CustomerCommunityUserAccount" class="large green button">My Account</a></p> -->

                                <!--<p>Upgrade</p>--> 
                            </div>
                            <apex:form styleClass="twelve columns">
                                <apex:pageBlock id="details">
                                    <div class="twelve" style="margin-bottom: 5px;">
                                        <h1>My Support Cases</h1>
                                        <div class="right" id="my-support-cases">
                                            <div class="pagination-controls">
                                                <apex:commandButton styleClass="paginationBtn" value="|<" rerender="details" action="{!beginning}" disabled="{!prev}" title="First"/>
                                                <apex:commandButton styleClass="paginationBtn" value="<" rerender="details" action="{!previous}" disabled="{!prev}" title="Previous"/>
                                                <apex:commandButton styleClass="paginationBtn" value=">" rerender="details" action="{!next}" disabled="{!nxt}" title="Next"/>
                                                <apex:commandButton styleClass="paginationBtn" value=">|" rerender="details" action="{!end}" disabled="{!nxt}" title="Last"/>
                                            </div>
                                            <span id="page-xofy" class="right helpTxtFontSize" style="font-style: italic; margin-right: 5px;">Page {!currentPage} of {!lastPage}</span>
                                            <a href="/portal/s/" target="_blank" class="two-row green new-button create-new-case" style="margin-right:3px;margin-top:10px">Download Center</a>
                                            <a href="/Support/CustomerCommunityFindHardWare?AccId={!user.Accountid}" class="two-row green new-button create-new-case" style="margin-right:3px"> Create New Case Search My Products</a>
                                        </div>
                                    </div>
                                    <apex:pageblockTable value="{!caseRslt}" var="case" styleClass="myCaseTable twelve" style="">
                                        <apex:column headerValue="Case Number" styleClass="">
                                            <apex:outputLink value="/Support/CustomerCommunityCaseDetail?caseid={!case.Id}">{!case.CaseNumber}</apex:outputLink>
                                        </apex:column>
                                        <apex:column value="{!case.Request_Title__c}" headerValue="Title" styleClass="title"/>
                                        <apex:column value="{!case.Description}" headerValue="Description" />
                                        <apex:column value="{!case.CreatedDate}" headerValue="Date Opened"/>     
                                        <apex:column value="{!case.Status}" headerValue="Status"/>            
                                    </apex:pageblockTable>   
                                </apex:pageBlock>
                            </apex:form>  
                            <!-- sarvinder changes start -->
                           
                            <!-- sarvinder changes end -->
                                                           
                            <!--   <div class="nine columns" style="margin-top: 25px;">
                                <h1>My Support Cases</h1>
                                <a href="/Support/CustomerCommunityFindHardWare?AccId={!user.Accountid}" class="large red button create-new-case" style="float: right;">Create New Case</a>

