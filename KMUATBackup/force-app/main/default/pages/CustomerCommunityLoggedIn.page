                                                <td>{!case.Status}</td>
                                            </tr>
                                        </apex:repeat> 
                                        

                                   </tbody>
                                </table> 
                           </div> -->
                        </div>

                </div>
            </div>
            <!-- End of Case Area -->

            <!-- KB Area -->
            <div class="row">

                <div class="six columns">
                        <h2>Service Announcements</h2>
                        <p>Our interactive support center is your direct link to answers you need. Search our knowledge base, check support tickets, learn about RMAs and contact Allied Telesis technical experts.</p>
                </div>

                <div class="six columns">

                        <hr class="show-for-small" />
                        <h2>Knowledge Base</h2><br/>
                        <h5>Top Articles</h5>
                        <apex:outputPanel layout="block">
                            <!--
                            <ul>
                                <knowledge:articleList articleVar="article"
                                    articleTypes="Question_Answer__kav"
                                    sortBy="mostViewed"
                                    pageSize="10"
                                    language="en_US"
                                >
                                    <li><a href="{!URLFOR($Action.KnowledgeArticle.View, article.id)}">{!article.title}</a></li>
                                </knowledge:articleList>
                            </ul>
                            -->
                            <ul class="kb-articles-container">
                                <apex:repeat value="{!qa}" var="article">
                                    <li>
                                        <a href="/Support/CustomerCommunityArticle?articleId={!article.Id}" target="_blank">{!article.title}</a>
                                    </li>
                                </apex:repeat>
                            </ul>
                            <!-- <div style="text-align:right;">
                                <a href="/Support/CustomerCommunityArticlesList">Full List</a>
                            </div> -->
                            <apex:form >
                                <div class="twelve">
                                    <apex:inputText value="{!searchTerm}" styleClass="nine searchInput" html-placeholder="Enter search keyword"/> 
                                    <apex:commandButton value="Go" title="Go" action="{!searchKB}" styleClass="two button large goBtn"/>
                                </div>
                            </apex:form>
                        </apex:outputPanel>

                </div>
            </div>
            <!-- End of KB Area -->
