<apex:page showHeader="false" sidebar="false" controller="CustomerCommunityLoggedInController" action="{!forwardToCustomAuthPage}" >
    <apex:composition template="CustomerSupportTemplate">
        <apex:define name="body">
            <style type="text/css">
                /* Override Salesforce default styling */
                /* TODO: See if there is better way to do this; */
                table th {
                    font-family: "Roboto","HelveticaNeueBoldCond","Helvetica Narrow","Arial Narrow";
                    font-weight: bold !important;
                    color: white !important;
                    background-color: #4f7389 !important;
                    padding: 8px !important;
                }
                table tbody tr:nth-child(even) {
                    background: #d4eff4 !important;
                }
                table tbody tr:nth-child(even) {
                    background: #f9f9f9 !important;
                }
                tr.dataRow.highlight td {
                    background: inherit !important;
                } 
                td {
                    padding: 8px !important;
                    border: none !important;
                }
                .myCaseTable {
                    border-spacing: 2px;
                    border-collapse: separate;
                    border: 1px solid #ddd !important;
                }
                .myCaseBtnContainer {

                }
                .create-new-case {
                    color: #fff !important;
                }
                div#my-support-cases input {
                    position: relative;
                    top: -18px;
                }
                span#page-xofy {
                    position: relative;
                    top: 23px;
                }
            </style>
            <!-- Case Area -->
            <div class="row">
                <div class="twelve columns">

                        <div class="row">
                            <div class="four" style="margin-left: 15px; margin-bottom: 20px;">
                                <h3>Welcome, {!name}</h3>
                                <apex:messages />
