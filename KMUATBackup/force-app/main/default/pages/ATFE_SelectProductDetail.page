<apex:page standardController="OpportunityLineItem" extensions="ATFE_SelectProductClass">

<apex:includeScript value="https://ajax.googleapis.com/ajax/libs/jquery/1.4/jquery.min.js"/>
<script type="text/javascript">
$(document).ready(function(){
    var errorValues = ["quanity"];          
            
    for (i = 0; i < errorValues.length; i++) {
        var st = '\'span[id$="' + errorValues[i] + 'Error"]\'';
        var ErrorHtml = $(st);
        if (ErrorHtml.length != 0){
            var Errorstring = ErrorHtml.html().split(errorValues[i] + ": ");
            ErrorHtml.html(Errorstring[1]);
        }
    }
});

</script>
    <apex:form >
        <apex:pageBlock title="" mode="edit">
 
            <apex:pageBlockButtons >
                <apex:commandButton action="{!save}" value="Save"/>
                <apex:commandButton action="{!back}" value="Cancel"/>
            </apex:pageBlockButtons>
 
            <apex:pageBlockSection title="You Selected" columns="1">
                <apex:pageBlockTable value="{!selectedProducts}" var="product">                    
                    <apex:column headerValue="Product Name">
                        <a href="/{!product.pbe.Product2Id}">{!product.pbe.Name}</a>
                    </apex:column>
                    <apex:column headerValue="Product Code">
                        <a href="/{!product.pbe.Product2Id}">{!product.pbe.ProductCode}</a>
                    </apex:column>
                    <apex:column headerValue="List Price" styleClass="CurrencyElement">
                        {!product.pbe.UnitPrice}
                    </apex:column>
                    <apex:column headerValue="Quanity">
                        <div class="requiredInput">
                            <div class="requiredBlock"></div>
                            <apex:inputText id="quanity" required="true" value="{!productQuanity}"/>
                            <br/><apex:message for="quanity" id="quanityError"/>
                        </div>
                    </apex:column>
                </apex:pageBlockTable>
            </apex:pageBlockSection>           
 
        </apex:pageBlock>
    </apex:form>
</apex:page>