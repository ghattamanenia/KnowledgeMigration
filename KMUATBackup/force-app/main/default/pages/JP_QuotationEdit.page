    var StandardPrice = jQuery(id + 'StandardPrice');
    var quantity = jQuery(id + 'quantity');
    var Unit = jQuery(id + 'Unit');
    var WholeSaleRate = jQuery(id + 'WholeSaleRate');
    var SpecialWholeSaleTRate_sp = jQuery(id + 'SpecialWholeSaleTRate_sp');
    var UnitPrice = jQuery(id + 'UnitPrice');
    var SpeciaUnitPrice_sp = jQuery(id + 'SpeciaUnitPrice_sp');
    var DiscountLimitPrice = jQuery(id + 'DiscountLimitPrice');
    var PercentDiscount = jQuery(id + 'PercentDiscount');
    var OverLimitDiscount = jQuery(id + 'OverLimitDiscount');
    var WholeSalePriceMulQuantity = jQuery(id + 'WholeSalePriceMulQuantity');
    var SpecialUnitPriceMulQuantity = jQuery(id + 'SpecialUnitPriceMulQuantity');
    var StandardMinusSpecial = jQuery(id + 'StandardMinusSpecial');
    var DeterminedAmount = jQuery(id + 'DeterminedAmount');
    var QuotationDescription = jQuery(id + 'QuotationDescription');
    var QuotationRemarks = jQuery(id + 'QuotationRemarks');
    var SalesStatus = jQuery(id + 'SalesStatus');
    var ReleaseScheduled = jQuery(id + 'ReleaseScheduled');
    var SalesEndScheduled = jQuery(id + 'SalesEndScheduled');
    var DistributorProCode = jQuery(id + 'DistributorProCode');
    var PriceYearMonth = jQuery(id + 'PriceYearMonth');
    var AppGroupID = jQuery(id + 'AppGroupID');
    var tankaChecked = jQuery('[id$=tanka]').prop("checked");

    if (productCatalogCode.val() == '****') {
        // 登録外商品
        columnEnable(productCatalogCode, true);
        columnEnable(productName, true);
        columnEnable(StandardPrice, true);
        columnEnable(quantity, true);
        columnEnable(Unit, true);
        columnEnable(WholeSaleRate, true);
        columnEnable(UnitPrice, true);
        columnEnable(DiscountLimitPrice, true);
        columnEnable(PercentDiscount, false);
        columnEnable(OverLimitDiscount, false);
        columnEnable(WholeSalePriceMulQuantity, false);
        columnEnable(SpecialUnitPriceMulQuantity, false);
        columnEnable(StandardMinusSpecial, false);
        columnEnable(DeterminedAmount, false);
        columnEnable(QuotationDescription, true);
        //20161101 add start
        columnEnable(QuotationRemarks, true);
        //20161101 add end
        columnEnable(SalesStatus, true);
        columnEnable(ReleaseScheduled, true);
        columnEnable(SalesEndScheduled, true);
        columnEnable(DistributorProCode, true);
        columnEnable(PriceYearMonth, true);
        columnEnable(AppGroupID, true);

        if (tankaChecked) {
            columnEnable(SpeciaUnitPrice_sp, true);
            columnEnable(SpecialWholeSaleTRate_sp, false);
        } else {
            columnEnable(SpeciaUnitPrice_sp, false);
            columnEnable(SpecialWholeSaleTRate_sp, true);
        }
    } else if (productCatalogCode.val() == '-') {
        // メモ
        columnEnable(productCatalogCode, true);
        columnEnable(productName, true);
        columnEnable(StandardPrice, false);
        columnEnable(quantity, false);
        columnEnable(Unit, false);
        columnEnable(WholeSaleRate, false);
        columnEnable(SpecialWholeSaleTRate_sp, false);
        columnEnable(UnitPrice, false);
        columnEnable(SpeciaUnitPrice_sp, false);
        columnEnable(DiscountLimitPrice, false);
        columnEnable(PercentDiscount, false);
        columnEnable(OverLimitDiscount, false);
        columnEnable(WholeSalePriceMulQuantity, false);
        columnEnable(SpecialUnitPriceMulQuantity, false);
        columnEnable(StandardMinusSpecial, false);
        columnEnable(DeterminedAmount, false);
        columnEnable(QuotationDescription, false);
        //20161101 add start
        columnEnable(QuotationRemarks, true);
        //20161101 add end
        columnEnable(SalesStatus, false);
        columnEnable(ReleaseScheduled, false);
        columnEnable(SalesEndScheduled, false);
        columnEnable(DistributorProCode, false);
        columnEnable(PriceYearMonth, false);
        columnEnable(AppGroupID, false);
    } else {
        // 通常
        columnEnable(productCatalogCode, true);
        columnEnable(productName, false);
        columnEnable(StandardPrice, false);
        columnEnable(quantity, true);
        columnEnable(Unit, true);
        columnEnable(WholeSaleRate, false);
        columnEnable(UnitPrice, false);
        columnEnable(DiscountLimitPrice, false);
        columnEnable(PercentDiscount, false);
        columnEnable(OverLimitDiscount, false);
        columnEnable(WholeSalePriceMulQuantity, false);
        columnEnable(SpecialUnitPriceMulQuantity, false);
