    var quantity = document.getElementById('{!$Component.form.mitumori_msi.inputArea.detailBlock}' + ':' + rowNum + ':quantity').value;
    // 商品コードと数量が入力されていれば検索
    // 20160421 登録外商品（ｚ）及びコメント行（-）の時も動作する様に修正
    if ((autosumflg == true && productcode != '') || productcode == 'z' || productcode == '-' || productcode == '****') {
        startLoading();
        // disabled解除
        allQuotationDetailEnabled();
        document.getElementById('selectedRowNum').value = rowNum;
        searchProductInfo(rowNum);

        // disabled再設定
        allQuotationDetailInputControl();
    } else{
        document.getElementById('{!$Component.form.mitumori_msi.inputArea.detailBlock}' + ':' + rowNum + ':quotationDetail').value = '';
    }
        // setDefaultQuotationDetail (); // Alliedtelesis-462 コメントアウト
}

/**
 * 商品関連エラー
 */
function productNotFound() {
    var rowNum = document.getElementById('selectedRowNum');
    var productCode = document.getElementById('{!$Component.form.mitumori_msi.inputArea.detailBlock}:' + rowNum.value + ':errProductCatalogCode');
    var errCode = document.getElementById('{!$Component.form.mitumori_msi.inputArea.detailBlock}:' + rowNum.value + ':errCode');
    var msg = '\'' + productCode.value + '\'';

  //alert(rowNum.value);
  //alert(productCode.value);
  //alert(errCode.value + msg.value);


    if (errCode.value == '1') {
        // 該当製品なし
        msg += '{!$Label.JP_DistributorPriceNotFound}';
        alert(msg);
    } else if (errCode.value == '2') {
        // 特殊代理店製品
        msg += '{!$Label.JP_SpecialProduct}';
        alert(msg);
    } else if (errCode.value == '3') {
        // PI在庫誘導製品
        msg += '{!$Label.JP_PIStock}';
        alert(msg);
    }

    productCode.value = '';
    errCode.value = '';
    rowNum.value = '';
}

/**
 * 仕切表を元に計算　商品関連エラー
 */
function productNotFoundbyMath() {

    var msg = '';
    var i = 0;
    
    while (document.getElementById('{!$Component.form.mitumori_msi.inputArea.detailBlock}:' + i + ':errCode') != undefined) {
        var rowNum = i;
        var productCode = document.getElementById('{!$Component.form.mitumori_msi.inputArea.detailBlock}:' + i + ':errProductCatalogCode');
        var errCode = document.getElementById('{!$Component.form.mitumori_msi.inputArea.detailBlock}:' + i + ':errCode');

        if (errCode.value == '1') {
            // 該当製品なし
            msg += '\'' + productCode.value + '\',';
        }
        ++i;
    }
    
    if(msg != ''){
        msg += '{!$Label.JP_DistributorPriceNotFound}';
        alert(msg);
    }
    
    productCode.value = '';
    errCode.value = '';
    rowNum.value = '';
}

