// 見積明細背景色変更
function changeBG() {
    var baseId = '{!$Component.form.mitumori_msi.inputArea.detailBlock}';
    changeProductNameBG(baseId);
    changeSpeciaUnitPrice(baseId);
    changeDiscountLimitPrice(baseId);
    changePercentDiscount(baseId);
    changeProductCodeAndSalesStatus(baseId);
}

// 商品名項目背景色変更
function changeProductNameBG(baseId) {
    var i = 0;
    while (document.getElementById(baseId + ':' + i + ':productName') != undefined) {
        var id = collonEscape('#' + baseId + ':' + i + ':');
        if (jQuery(id + 'requiredMaintenanceFlag').val() == 'true') {
            jQuery(id + 'productName').css('background-color', 'DeepSkyBlue');
        } else {
            jQuery(id + 'productName').css('background-color', '');
        }
        ++i;
    }
}

// 特別仕切単価背景色変更
function changeSpeciaUnitPrice(baseId) {
    var i = 0;
    while (document.getElementById(baseId + ':' + i + ':SpeciaUnitPrice_sp') != undefined) {
        var id = collonEscape('#' + baseId + ':' + i + ':');
        var specialUnitPrice = toInt(jQuery(id + 'SpeciaUnitPrice_sp'));
        var percentDiscount = toInt(jQuery(id + 'PercentDiscount'));
        var discountLimitPrice = toInt(jQuery(id + 'DiscountLimitPrice'));
        var unitPrice = toInt(jQuery(id + 'UnitPrice'));

        if ((specialUnitPrice < percentDiscount || specialUnitPrice < discountLimitPrice) && specialUnitPrice != 0) {
            jQuery(id + 'SpeciaUnitPrice_sp').css('background-color', 'red');
            jQuery(id + 'SpeciaUnitPrice_sp').css('color', 'white');
        } else if (specialUnitPrice < unitPrice && specialUnitPrice >= percentDiscount && specialUnitPrice >= discountLimitPrice) {
            jQuery(id + 'SpeciaUnitPrice_sp').css('background-color', 'YellowGreen');
        } else {
            jQuery(id + 'SpeciaUnitPrice_sp').css('background-color', '');
        }
        ++i;
    }
}

// 値引限度額背景色変更
function changeDiscountLimitPrice(baseId) {
    var i = 0;
    while (document.getElementById(baseId + ':' + i + ':DiscountLimitPrice') != undefined) {
        var id = collonEscape('#' + baseId + ':' + i + ':');
        var specialUnitPrice = toInt(jQuery(id + 'SpeciaUnitPrice_sp'));
        var discountLimitPrice = toInt(jQuery(id + 'DiscountLimitPrice'));

        if (specialUnitPrice < discountLimitPrice && specialUnitPrice != 0 ) {
            jQuery(id + 'DiscountLimitPrice').css('background-color', 'red');
            jQuery(id + 'DiscountLimitPrice').css('color', 'white');
        } else {
            jQuery(id + 'DiscountLimitPrice').css('background-color', '');
        }
        ++i;
    }
}

// 仕切5%減背景色変更
function changePercentDiscount(baseId) {
    var i = 0;
    while (document.getElementById(baseId + ':' + i + ':PercentDiscount') != undefined) {
        var id = collonEscape('#' + baseId + ':' + i + ':');
        var specialUnitPrice = toInt(jQuery(id + 'SpeciaUnitPrice_sp'));
        var percentDiscount = toInt(jQuery(id + 'PercentDiscount'));
        var discountLimitPrice = toInt(jQuery(id + 'DiscountLimitPrice'));
        var unitPrice = toInt(jQuery(id + 'UnitPrice'));

        if (specialUnitPrice < percentDiscount && specialUnitPrice != 0 ) {
            jQuery(id + 'PercentDiscount').css('background-color', 'red');
            jQuery(id + 'PercentDiscount').css('color', 'white');
        } else if (specialUnitPrice < unitPrice && specialUnitPrice >= percentDiscount && specialUnitPrice >= discountLimitPrice) {
            jQuery(id + 'PercentDiscount').css('background-color', 'YellowGreen');
        } else {
            jQuery(id + 'PercentDiscount').css('background-color', '');
        }
        ++i;
    }
}

// 製品コード・販売状態背景色変更
function changeProductCodeAndSalesStatus(baseId) {
    var i = 0;
    while (document.getElementById(baseId + ':' + i + ':PercentDiscount') != undefined) {
        var id = collonEscape('#' + baseId + ':' + i + ':');
        var PiStock = jQuery(id + 'PiStock');

        if (PiStock.val() == "true") {
            jQuery(id + 'productCatalogCode').css('background-color', 'Yellow');
            jQuery(id + 'SalesStatus').css('background-color', 'Yellow');
        } else {
            jQuery(id + 'productCatalogCode').css('background-color', '');
            jQuery(id + 'SalesStatus').css('background-color', '');
        }
        ++i;
    }
}

// 数値変換
function toInt(val) {
    var dest = 0;
    if (val.val() != '') {
        var num = val.val().replace(/,/g, '');
        if (jQuery.isNumeric(num)) {
            dest = parseInt(num, 10);
        }
    }

    return dest;
}

// 実数変換
function toFloat(val) {
    var dest = 0;
    if (val.val() != '' && val.val().match(/^-?[0-9]+\.[0-9]+$/)) {
        dest = parseFloat(val.val());
    }

    return dest;
}

// :をjQueryセレクタで使用できるようエスケープ
function collonEscape(val){
    return val.replace(/:/g, '\\:');
}

//行を取得する
function getRowNo(id){
    var idArr = id.split(':');
    var len = idArr.length;
    return idArr[len-2];
}
    
// 商品情報をセットする
// @param rowNum アクションが発火した明細一覧行番号
function setProductInfo(rowNum) {
    var autosumflg = document.getElementById('{!$Component.form.mitumori_msi.autosumflg}').checked;
    var id = collonEscape('#{!$Component.form.mitumori_msi.inputArea.detailBlock}' + ':' + rowNum + ':');
