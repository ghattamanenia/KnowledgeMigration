/**
 * 項目の有効化
 * @param val 対象項目
 * @param flg true:有効 false：無効
 */
function columnEnable(val, flg) {
    if (flg == true) {
        val.removeAttr('disabled');
    } else {
        val.attr('disabled','disabled').css('color','black');
    }
}

