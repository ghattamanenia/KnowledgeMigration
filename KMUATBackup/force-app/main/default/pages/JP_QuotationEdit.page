                            <apex:inputField value="{!qd.obj.JP_ReleaseScheduled__c}" style="width:60px;" id="ReleaseScheduled" />
                        </apex:column>
                        <!-- 販売終了予定 -->
                        <apex:column >
                            <apex:facet name="header">{!$ObjectType.JP_QuotationDetail__c.fields.JP_SalesEndScheduled__c.label}</apex:facet>
                            <apex:inputField value="{!qd.obj.JP_SalesEndScheduled__c}" style="width:140px;" id="SalesEndScheduled" />
                        </apex:column>
                        <!-- 代理店専用製品コード -->
                        <apex:column >
                            <apex:facet name="header">{!$ObjectType.JP_QuotationDetail__c.fields.JP_DistributorProCode__c.label}</apex:facet>
                            <apex:inputField value="{!qd.obj.JP_DistributorProCode__c}" style="width:110px;" id="DistributorProCode" />
                        </apex:column>
                        <!-- 価格年月 -->
                        <apex:column >
                            <apex:facet name="header">{!$ObjectType.JP_QuotationDetail__c.fields.JP_PriceYearMonth__c.label}</apex:facet>
                            <apex:inputField value="{!qd.obj.JP_PriceYearMonth__c}" style="width:80px;" id="PriceYearMonth" />
                        </apex:column>
                    </apex:pageBlockTable>
                </apex:pageBlockSection>
            </div>
        </apex:pageBlock>
    </apex:form>
    <!-- 製品検索コンポーネント-->
    
    <div id="comp1" style="display:none;">
        <c:ProductSearch id="compo1" parentDistributor="{!parentDistributor}" priceListType="{!priceListType}" quotationDetailList="{!qDetailOriginalList}" index="{!index}" />
    </div>

    <!-- Loading icon & Overlay -->
    <div class="loadingBox loader" />
    <div class="loadingBox overlay" />
    
</apex:page>